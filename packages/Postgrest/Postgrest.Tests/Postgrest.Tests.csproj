<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<AssemblyName>Postgrest.Tests</AssemblyName>
		<RootNamespace>Postgrest.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<WarningsAsErrors>CS8600;CS8602;CS8603</WarningsAsErrors>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.3.2" />
		<PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="FluentAssertions" Version="[7.2.2]" />
		<PackageReference Include="NSubstitute" Version="[6.0.0]" />
		<PackageReference Include="Npgsql" Version="[8.0.6]" />
		<PackageReference Include="WireMock.Net" Version="2.12.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Postgrest\Postgrest.csproj" />
	</ItemGroup>

	<!--
	  Mutation-harness scoping: Stryker cannot filter by [TestCategory], so when STRYKER_MUTATION=true we
	  compile-exclude the E2E tests (which drive the live Supabase CLI stack, are slow, and are
	  non-deterministic per-mutant). Stryker then runs only the fast, hermetic Unit + Contract tests once
	  per mutant. The mutate scope is pinned in stryker-config.json. MSBuild resolves the environment
	  variable automatically; Stryker's child build inherits it.
	-->
	<ItemGroup Condition="'$(STRYKER_MUTATION)' == 'true'">
		<Compile Remove="Attaching\AttachedModelTests.cs" />
		<Compile Remove="Caching\CachedTableTests.cs" />
		<Compile Remove="Events\RequestLifecycleTests.cs" />
		<Compile Remove="Filtering\FilterQueryTests.cs" />
		<Compile Remove="Linq\LinqQueryTests.cs" />
		<Compile Remove="Options\SchemaTests.cs" />
		<Compile Remove="Paging\PagingQueryTests.cs" />
		<Compile Remove="Reading\ReadTests.cs" />
		<Compile Remove="References\ReferenceTests.cs" />
		<Compile Remove="Rpc\StoredProcedureTests.cs" />
		<Compile Remove="Serialization\CoercionTests.cs" />
		<Compile Remove="Sorting\OrderingQueryTests.cs" />
		<Compile Remove="Writing\WriteTests.cs" />
	</ItemGroup>
</Project>
